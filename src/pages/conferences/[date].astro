---
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import {
  getAllConferences,
  getConference,
  outlets as outletColorData,
} from "../../lib/data";

export async function getStaticPaths() {
  return getAllConferences().map((c) => ({ params: { date: c.meta.date } }));
}

const { date } = Astro.params;
const conf = getConference(date!);
if (!conf) return Astro.redirect("/");

// Outlet stats for chart
const outletMap: Record<
  string,
  { crits: number[]; hosts: number[]; count: number }
> = {};
for (const q of conf.questions) {
  if (!outletMap[q.outlet])
    outletMap[q.outlet] = { crits: [], hosts: [], count: 0 };
  outletMap[q.outlet].crits.push(q.criticism_percent);
  outletMap[q.outlet].hosts.push(q.hostility_percent);
  outletMap[q.outlet].count++;
}
const outletStats = Object.entries(outletMap)
  .map(([name, d]) => ({
    name,
    avgCrit: Math.round(d.crits.reduce((a, b) => a + b, 0) / d.crits.length),
    avgHost: Math.round(d.hosts.reduce((a, b) => a + b, 0) / d.hosts.length),
    count: d.count,
  }))
  .sort((a, b) => b.avgCrit - a.avgCrit);

// Overall stats
const qCount = conf.questions.length;
const reporterCount = new Set(conf.questions.map((q) => q.reporter)).size;
const outletCount = outletStats.length;
const avgCrit = Math.round(
  conf.questions.reduce((s, q) => s + q.criticism_percent, 0) / qCount,
);
const avgHost = Math.round(
  conf.questions.reduce((s, q) => s + q.hostility_percent, 0) / qCount,
);
const maxCrit = Math.max(...conf.questions.map((q) => q.criticism_percent));

const allOutlets = outletStats.map((o) => o.name);

const allTags = [...new Set(conf.questions.flatMap((q) => q.tags))].sort();

// Timeline chart data
const chartPoints = conf.questions.map((q) => ({
  t: timeToSeconds(q.start_time),
  crit: q.criticism_percent,
  host: q.hostility_percent,
  id: q.id,
  reporter: q.reporter,
  outlet: q.outlet,
}));

// Map outlet name to color/text_color
const outletColors: Record<string, { color: string; text_color: string }> =
  Object.fromEntries(
    outletColorData.map((o) => [
      o.name,
      { color: o.color, text_color: o.text_color },
    ]),
  );

function timeToSeconds(t: string): number {
  const parts = t.split(":").map(Number);
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  return 0;
}
---

<Layout
  title={conf.meta.title}
  description={`${conf.meta.date} — ${qCount} kérdés, ${outletCount} médium. Átlagos kritikusság: ${avgCrit}%, ellenségesség: ${avgHost}%.`}
  ogImage={`/og/${date}.png`}
>
  <!-- Masthead -->
  <header class="bg-fg text-bg">
    <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pt-8 pb-8">
      <a
        href="/"
        class="inline-block font-mono text-[11px] tracking-[1px] uppercase text-[#777] no-underline mb-5 transition-colors duration-150 hover:text-[#e8624e]"
        >← Összes sajtótájékoztató</a
      >
      <div class="font-mono text-xs tracking-[2px] uppercase text-[#888] mb-3">
        {conf.meta.date.replace(/-/g, ". ")} · {conf.meta.location}
      </div>
      <h1
        class="font-display text-[clamp(32px,6vw,60px)] font-black leading-tight mb-5 tracking-[-1px]"
      >
        {conf.meta.title}
      </h1>
      {(() => {
        const minister = conf.speakers.find((s) => s.role === "miniszter") ?? conf.speakers[0];
        return minister ? (
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-8 rounded-full bg-[#e8624e] flex items-center justify-center shrink-0">
              <span class="font-display font-black text-white text-[13px]">
                {minister.name.split(" ").map((w: string) => w[0]).join("").slice(0, 2)}
              </span>
            </div>
            <div>
              <div class="font-display text-[20px] font-bold text-white leading-tight">
                {minister.name}
              </div>
              <div class="font-mono text-[10px] uppercase tracking-[1.5px] text-[#999] mt-0.5">
                {minister.role}
              </div>
            </div>
          </div>
        ) : null;
      })()}
      <div class="flex gap-2 flex-wrap">
        <div
          class="text-[12px] font-medium px-2.5 py-1 rounded-full bg-white/8 text-[#aaa]"
        >
          {conf.meta.duration}
        </div>
        <a
          href={conf.meta.youtube_url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[12px] font-medium px-2.5 py-1 rounded-full bg-white/8 text-[#aaa] no-underline transition-colors duration-150 hover:bg-white/15 hover:text-white flex items-center gap-1.5"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="10"
            viewBox="0 0 16 11"
            ><path
              d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z"
              fill="#FF0000"></path><path
              d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z"
              fill="#fff"></path></svg
          >
          YouTube
        </a>
      </div>
    </div>
  </header>

  <!-- Stats bar -->
  <div class="bg-bg2 border-b border-border">
    <div
      class="max-w-300 mx-auto px-6 max-[480px]:px-4 py-5 grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] max-[700px]:grid-cols-3 gap-4"
    >
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {qCount}
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Kérdés
        </div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {reporterCount}
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Újságíró
        </div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {outletCount}
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Médium
        </div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {avgCrit}%
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Átl. kritikusság
        </div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {avgHost}%
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Átl. ellenségesség
        </div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">
          {maxCrit}%
        </div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">
          Max kritikusság
        </div>
      </div>
    </div>
  </div>

  <!-- Reading progress bar -->
  <div
    id="readProgressBar"
    class="sticky top-0 w-full z-200 pointer-events-none flex items-center"
    style="height:12px;background:rgba(232,98,78,0.08)"
  >
    <div
      id="readProgressFill"
      class="h-full bg-accent flex items-center justify-end pr-2"
      style="width:0%;transition:width 0.15s ease;min-width:0"
    >
      <span
        id="readProgressLabel"
        class="font-mono text-[10px] font-bold text-white leading-none opacity-0"
        >0%</span
      >
    </div>
  </div>

  <!-- Opening statements -->
  <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pt-8 pb-3">
    <h2 class="font-display text-2xl font-bold flex items-center gap-2.5">
      Nyitó nyilatkozatok <span
        class="font-mono text-sm font-normal text-fg3 bg-bg2 px-2.5 py-0.5 rounded-full"
        >{conf.opening_statements.length}</span
      >
    </h2>
  </div>
  <div
    class="max-w-300 mx-auto px-6 max-[480px]:px-4 pb-3 flex flex-col gap-4"
  >
    {
      conf.opening_statements.map((stmt) => {
        const sp = conf.speakers.find((s) => s.id === stmt.speaker_id);
        const stmtYtUrl = conf.meta.youtube_url
          ? `${conf.meta.youtube_url}&t=${timeToSeconds(stmt.start_time)}`
          : null;
        return (
          <div class="bg-white border border-[rgba(226,191,184,0.3)] rounded-lg overflow-hidden">
            <div class="flex items-center gap-3 px-8 pt-6 pb-4 max-[600px]:px-5 max-[600px]:pt-5">
              <div class="font-bold text-[15px]">
                {sp?.name}{" "}
                <span class="font-normal text-fg3">· {sp?.role}</span>
              </div>
              <div class="w-px h-4 bg-[rgba(226,191,184,0.4)]" />
              {conf.meta.youtube_video_id ? (
                <button
                  class="ts-btn font-mono text-sm font-medium text-accent bg-transparent border-none p-0 cursor-pointer transition-opacity duration-150 hover:opacity-70 hover:underline"
                  data-seek={timeToSeconds(stmt.start_time)}
                >
                  {stmt.start_time}
                </button>
              ) : stmtYtUrl ? (
                <a
                  href={stmtYtUrl}
                  target="_blank"
                  rel="noopener"
                  class="font-mono text-sm font-medium text-accent no-underline transition-opacity duration-150 hover:opacity-70 hover:underline"
                >
                  {stmt.start_time}
                </a>
              ) : (
                <span class="font-mono text-sm font-medium text-accent">
                  {stmt.start_time}
                </span>
              )}
            </div>
            <div class="expose-prose px-8 pb-6 max-[600px]:px-5 max-[600px]:pb-5">
              {stmt.summary.includes("\n") ? (
                <Fragment set:html={marked(stmt.summary)} />
              ) : (
                <p>{stmt.summary}</p>
              )}
              <div class="flex flex-wrap gap-1 mt-3">
                {stmt.tags.map((t) => (
                  <button class="open-tag tag" data-tag={t}>
                    {t}
                  </button>
                ))}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>

  <!-- Outlet charts -->
  <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 py-6">
    <h2 class="font-display text-xl font-bold mb-4">
      Médiumok összehasonlítása
    </h2>
    <div class="grid grid-cols-2 max-[700px]:grid-cols-1 gap-4">
      <div class="bg-white border border-border rounded-md p-4">
        <div
          class="text-[11px] font-bold tracking-[0.8px] uppercase mb-3 text-blue"
        >
          Kérdés kritikussága
        </div>
        <div
          class="relative"
          style={`height:${Math.max(160, outletStats.length * 36)}px`}
        >
          <canvas id="outletCritChart"></canvas>
        </div>
      </div>
      <div class="bg-white border border-border rounded-md p-4">
        <div
          class="text-[11px] font-bold tracking-[0.8px] uppercase mb-3 text-accent"
        >
          Válasz ellenségessége
        </div>
        <div
          class="relative"
          style={`height:${Math.max(160, outletStats.length * 36)}px`}
        >
          <canvas id="outletHostChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Timeline charts -->
  <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 py-6">
    <h2 class="font-display text-xl font-bold mb-4">Idővonal</h2>
    <div class="flex flex-col gap-4">
      <div class="bg-white border border-border rounded-md p-4">
        <div
          class="text-[11px] font-bold tracking-[0.8px] uppercase mb-3 text-blue"
        >
          Kérdés kritikussága
        </div>
        <div class="relative h-48">
          <canvas id="timelineCritChart"></canvas>
        </div>
      </div>
      <div class="bg-white border border-border rounded-md p-4">
        <div
          class="text-[11px] font-bold tracking-[0.8px] uppercase mb-3 text-accent"
        >
          Válasz ellenségessége
        </div>
        <div class="relative h-48">
          <canvas id="timelineHostChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script
    id="chart-data"
    type="application/json"
    set:html={JSON.stringify({
      chartPoints,
      outletStats,
      outletColors,
      videoId: conf.meta.youtube_video_id ?? null,
    })}
  />

  <!-- Floating YouTube player -->
  {
    conf.meta.youtube_video_id && (
      <div
        id="ytPlayer"
        class="fixed bottom-4 left-4 z-999 shadow-2xl rounded-lg overflow-hidden border border-border max-[480px]:bottom-3 max-[480px]:left-3"
        style="width:min(320px,calc(100vw - 2rem));background:#000"
      >
        <div class="flex items-center justify-between px-3 py-2 bg-fg text-bg select-none cursor-default">
          <div class="flex items-center gap-2 min-w-0">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="13"
              viewBox="0 0 16 11"
              class="shrink-0"
            >
              <path
                d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z"
                fill="#FF0000"
              />
              <path d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z" fill="#fff" />
            </svg>
            <span class="text-xs font-mono text-[#aaa] truncate">
              Hangnem · {conf.meta.date}
            </span>
          </div>
          <div class="flex gap-1 items-center shrink-0">
            <button
              id="ytMinimize"
              title="Minimalizál"
              class="text-[#888] hover:text-white transition-colors text-lg leading-none w-7 h-7 flex items-center justify-center rounded hover:bg-white/10"
            >
              −
            </button>
            <button
              id="ytClose"
              title="Bezár"
              class="text-[#888] hover:text-white transition-colors text-sm leading-none w-7 h-7 flex items-center justify-center rounded hover:bg-white/10"
            >
              ✕
            </button>
          </div>
        </div>
        <div id="ytEmbed" style="aspect-ratio:16/9;background:#000">
          <div id="ytTarget" style="width:100%;height:100%" />
        </div>
      </div>
    )
  }

<style>
  @media (max-width: 480px) {
    #ytPlayer {
      width: min(220px, calc(100vw - 1.5rem)) !important;
    }
  }
  .expose-prose :global(h2) {
    font-family: var(--font-display, serif);
    font-size: 1.2rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-fg);
  }
  .expose-prose :global(h3) {
    font-family: var(--font-display, serif);
    font-size: 1rem;
    font-weight: 700;
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
    color: var(--color-fg);
  }
  .expose-prose :global(p) {
    margin-bottom: 0.75rem;
    line-height: 1.7;
    color: var(--color-fg2);
  }
  .expose-prose :global(ul) {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg2);
    list-style-type: disc;
  }
  .expose-prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-fg2);
    list-style-type: decimal;
  }
  .expose-prose :global(li) {
    margin-bottom: 0.25rem;
    line-height: 1.6;
  }
  .expose-prose :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
  .expose-prose :global(h2:first-child) {
    margin-top: 0;
  }
  .read-check.is-read {
    border-color: var(--color-green);
    color: var(--color-green);
    background: color-mix(in srgb, var(--color-green) 8%, transparent);
  }
  .filter-btn.active {
    background: var(--color-fg);
    color: white;
  }
</style>

<!-- Filter controls -->
<div class="max-w-300 mx-auto px-6 max-[480px]:px-3 pt-6">
  <div class="flex gap-3 flex-wrap items-end">
    <div class="flex flex-col gap-1">
      <label for="fOutlet" class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold"
        >Médium</label
      >
      <select
        id="fOutlet"
        class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent"
      >
        <option value="">Mind ({allOutlets.length})</option>
        {allOutlets.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label for="fTag" class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold"
        >Téma</label
      >
      <select
        id="fTag"
        class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent"
      >
        <option value="">Mind ({allTags.length})</option>
        {allTags.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label for="fSearch" class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold"
        >Keresés</label
      >
      <input
        type="text"
        id="fSearch"
        placeholder="kérdés vagy válasz..."
        class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent w-45 max-[480px]:w-full"
      />
    </div>
    <button
      class="filter-btn font-body text-[13px] px-3.5 py-2 rounded-md bg-bg2 text-fg2 cursor-pointer transition-all duration-200 hover:bg-fg hover:text-white flex items-center gap-1.5"
      id="resetBtn"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"
        ></path><path d="M3 3v5h5"></path></svg
      >
      <span>Szűrők törlése</span>
    </button>
    <button
      class="filter-btn font-body text-[13px] px-3.5 py-2 rounded-md bg-bg2 text-fg2 cursor-pointer transition-all duration-200 hover:bg-fg hover:text-white flex items-center gap-1.5"
      id="hideReadBtn"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"
        ></path><circle cx="12" cy="12" r="3"></circle></svg
      >
      <span class="btn-label">Elolvasottak elrejtése</span>
    </button>
    <button
      class="filter-btn font-body text-[13px] px-3.5 py-2 rounded-md bg-bg2 text-fg2 cursor-pointer transition-all duration-200 hover:bg-fg hover:text-white flex items-center gap-1.5"
      id="unreadAllBtn"
    >
      <svg
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        ><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6m0-6 6 6"
        ></path></svg
      >
      <span>Mind olvasatlan</span>
    </button>
  </div>
</div>

<!-- Q&A -->
<div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pt-8 pb-3">
  <h2 class="font-display text-2xl font-bold flex items-center gap-2.5">
    Kérdések és válaszok <span
      class="font-mono text-sm font-normal text-fg3 bg-bg2 px-2.5 py-0.5 rounded-full"
      id="qCount">{qCount} / {qCount}</span
    >
  </h2>
</div>
<div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pb-10" id="qaList">
  {
    conf.questions.map((q) => {
      const ytUrl = conf.meta.youtube_url
        ? `${conf.meta.youtube_url}&t=${timeToSeconds(q.start_time)}`
        : null;
      const critC = 2 * Math.PI * 34;
      const hostC = 2 * Math.PI * 34;
      const critOffset = critC - (q.criticism_percent / 100) * critC;
      const hostOffset = hostC - (q.hostility_percent / 100) * hostC;

      return (
        <div
          class="qa-card bg-white border border-[rgba(226,191,184,0.3)] rounded-lg mb-6 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.05)]"
          id={`card-${q.id}`}
          data-outlet={q.outlet}
          data-tags={q.tags.join(",")}
          data-crit={q.criticism_percent}
          data-host={q.hostility_percent}
          data-text={`${q.question} ${q.answer}`.toLowerCase()}
        >
          <div class="flex items-start justify-between p-5 border-b border-[rgba(226,191,184,0.1)] gap-3 max-[700px]:p-4">
            <div class="flex items-center gap-4 max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-2">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[10px] uppercase font-bold tracking-[1.5px] text-fg3">
                  Újságíró:
                </span>
                <span class="font-display italic text-[15px] text-fg">
                  {q.reporter}
                </span>
              </div>
            </div>
            <div class="flex items-center gap-3 shrink-0 max-[700px]:flex-col max-[700px]:items-end max-[700px]:gap-2">
              {(() => {
                const c = outletColors[q.outlet];
                return c ? (
                  <span
                    class="px-3 py-1.5 rounded-xs text-[10px] font-mono font-black tracking-[2px] uppercase"
                    style={`background:${c.color};color:${c.text_color}`}
                  >
                    {q.outlet}
                  </span>
                ) : (
                  <span class="bg-fg3 text-white px-3 py-1.5 rounded-xs text-[10px] font-mono font-black tracking-[2px] uppercase">
                    {q.outlet}
                  </span>
                );
              })()}
              <button
                class="read-check max-[700px]:hidden font-mono text-[11px] px-2.5 py-1 rounded border border-border text-fg3 bg-transparent cursor-pointer transition-all duration-150 hover:border-accent hover:text-accent"
                data-id={q.id}
                title="Megjelölés elolvasottként"
              >
                Elolvastam
              </button>
            </div>
          </div>

          <div class="qa-body grid grid-cols-[2fr_1fr] max-[700px]:grid-cols-1 gap-8 max-[700px]:gap-5 p-5 max-[700px]:p-4">
            <div class="min-w-0">
              <div class="mb-5">
                {(() => {
                  if (!q.question_start_time) return null;
                  const qsYtUrl = conf.meta.youtube_url
                    ? `${conf.meta.youtube_url}&t=${timeToSeconds(q.question_start_time)}`
                    : null;
                  return conf.meta.youtube_video_id ? (
                    <button
                      class="ts-btn mb-1.5 font-mono text-[10px] font-medium text-fg3 bg-transparent border-none p-0 cursor-pointer transition-colors duration-150 hover:text-accent hover:underline flex items-center gap-1"
                      data-seek={timeToSeconds(q.question_start_time)}
                    >
                      <svg width="9" height="9" viewBox="0 0 16 11" class="shrink-0"><path d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z" fill="currentColor"/><path d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z" fill="white"/></svg>
                      {q.question_start_time}
                    </button>
                  ) : qsYtUrl ? (
                    <a
                      href={qsYtUrl}
                      target="_blank"
                      rel="noopener"
                      class="mb-1.5 font-mono text-[10px] font-medium text-fg3 no-underline transition-colors duration-150 hover:text-accent hover:underline flex items-center gap-1"
                    >
                      <svg width="9" height="9" viewBox="0 0 16 11" class="shrink-0"><path d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z" fill="currentColor"/><path d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z" fill="white"/></svg>
                      {q.question_start_time}
                    </a>
                  ) : (
                    <span class="mb-1.5 font-mono text-[10px] font-medium text-fg3 flex items-center gap-1">
                      {q.question_start_time}
                    </span>
                  );
                })()}
                <h3 class="font-body text-[22px] max-[700px]:text-[18px] font-bold leading-tight text-fg tracking-[-0.3px]">
                  {q.question}
                </h3>
              </div>
              <div class="relative p-5 rounded-r-lg border-l-[5px] border-accent mb-3 [background:color-mix(in_srgb,var(--color-accent)_10%,transparent)]">
                <div class="absolute -top-3 -left-[10px] bg-accent text-white font-mono text-[9px] px-[7px] py-[3px] font-bold">
                  Válasz:
                </div>
                <p class="text-[15px] max-[700px]:text-sm leading-[1.7] text-fg">
                  {q.answer}
                </p>
                <div class="flex justify-end mt-3">
                  {conf.meta.youtube_video_id ? (
                    <button
                      class="ts-btn font-mono text-[11px] font-medium text-accent bg-transparent border-none p-0 cursor-pointer transition-opacity duration-150 hover:opacity-70 hover:underline flex items-center gap-1"
                      data-seek={timeToSeconds(q.start_time)}
                    >
                      <svg width="10" height="10" viewBox="0 0 16 11" class="shrink-0"><path d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z" fill="currentColor"/><path d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z" fill="white"/></svg>
                      {q.start_time}
                    </button>
                  ) : ytUrl ? (
                    <a
                      href={ytUrl}
                      target="_blank"
                      rel="noopener"
                      class="font-mono text-[11px] font-medium text-accent no-underline transition-opacity duration-150 hover:opacity-70 hover:underline flex items-center gap-1"
                    >
                      <svg width="10" height="10" viewBox="0 0 16 11" class="shrink-0"><path d="M15.67 1.72A2 2 0 0 0 14.26.3C13.01 0 8 0 8 0S2.99 0 1.74.3A2 2 0 0 0 .33 1.72C0 2.98 0 5.5 0 5.5s0 2.52.33 3.78a2 2 0 0 0 1.41 1.42C2.99 11 8 11 8 11s5.01 0 6.26-.3a2 2 0 0 0 1.41-1.42C16 8.02 16 5.5 16 5.5s0-2.52-.33-3.78z" fill="currentColor"/><path d="M6.4 7.86V3.14L10.55 5.5 6.4 7.86z" fill="white"/></svg>
                      {q.start_time}
                    </a>
                  ) : (
                    <span class="font-mono text-[11px] font-medium text-accent flex items-center gap-1">
                      {q.start_time}
                    </span>
                  )}
                </div>
              </div>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {q.tags.map((t) => (
                  <button
                    class="qa-tag text-[10px] font-semibold px-3 py-1 rounded-[3px] bg-bg2 text-fg2 border border-border transition-all duration-150 cursor-pointer hover:bg-blue-light hover:text-blue hover:border-blue hover:-translate-y-px"
                    data-tag={t}
                  >
                    {t}
                  </button>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-center border-l border-[rgba(226,191,184,0.1)] pl-5 max-[700px]:border-l-0 max-[700px]:border-t max-[700px]:border-[rgba(226,191,184,0.1)] max-[700px]:pl-0 max-[700px]:pt-4">
              {/* Desktop: circular charts */}
              <div class="flex flex-col items-center gap-5 max-[700px]:hidden">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 relative flex items-center justify-center">
                    <svg
                      width="80"
                      height="80"
                      viewBox="0 0 80 80"
                      style="transform:rotate(-90deg)"
                    >
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-border)"
                        stroke-width="5"
                      />
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-blue)"
                        stroke-width="6"
                        stroke-dasharray={critC}
                        stroke-dashoffset={critOffset}
                        stroke-linecap="round"
                      />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center font-mono text-[22px] font-bold">
                      {q.criticism_percent}
                      <span class="text-xs">%</span>
                    </div>
                  </div>
                  <div class="font-mono text-[9px] uppercase tracking-[1px] font-black text-fg3">
                    KRIT. INDEX
                  </div>
                </div>

                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 relative flex items-center justify-center">
                    <svg
                      width="80"
                      height="80"
                      viewBox="0 0 80 80"
                      style="transform:rotate(-90deg)"
                    >
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-border)"
                        stroke-width="5"
                      />
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-accent)"
                        stroke-width="6"
                        stroke-dasharray={hostC}
                        stroke-dashoffset={hostOffset}
                        stroke-linecap="round"
                      />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center font-mono text-[22px] font-bold">
                      {q.hostility_percent}
                      <span class="text-xs">%</span>
                    </div>
                  </div>
                  <div class="font-mono text-[9px] uppercase tracking-[1px] font-black text-fg3">
                    ELL. FAKTOR
                  </div>
                </div>
              </div>

              {/* Mobile: compact bar meters + read button */}
              <div class="hidden max-[700px]:flex flex-col gap-2 w-full">
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[9px] uppercase tracking-[1px] font-black text-fg3 w-14 shrink-0">
                    Krit.
                  </span>
                  <div class="flex-1 h-1.25 bg-bg3 rounded-full overflow-hidden">
                    <div
                      class="h-full bg-blue rounded-full"
                      style={`width:${q.criticism_percent}%`}
                    />
                  </div>
                  <span class="font-mono text-[11px] font-bold text-right w-8 shrink-0">
                    {q.criticism_percent}%
                  </span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="font-mono text-[9px] uppercase tracking-[1px] font-black text-fg3 w-14 shrink-0">
                    Ellen.
                  </span>
                  <div class="flex-1 h-1.25 bg-bg3 rounded-full overflow-hidden">
                    <div
                      class="h-full bg-accent rounded-full"
                      style={`width:${q.hostility_percent}%`}
                    />
                  </div>
                  <span class="font-mono text-[11px] font-bold text-right w-8 shrink-0">
                    {q.hostility_percent}%
                  </span>
                </div>
                <button
                  class="read-check mt-1 w-full font-mono text-[11px] px-2.5 py-2 rounded border border-border text-fg3 bg-transparent cursor-pointer transition-all duration-150 hover:border-accent hover:text-accent"
                  data-id={q.id}
                  title="Megjelölés elolvasottként"
                >
                  Elolvastam
                </button>
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<div
  class="max-w-300 mx-auto text-center px-6 py-15 text-fg3"
  id="emptyState"
  style="display:none"
>
  <div class="font-display text-2xl text-fg2 mb-2">Nincs találat</div>
  <div>Próbálj más szűrőket</div>
</div>

<script>
  import Chart from "chart.js/auto";

  // ── Data ────────────────────────────────────────────────────────────────────
  type ChartPoint = {
    t: number;
    crit: number;
    host: number;
    id: number;
    reporter: string;
    outlet: string;
  };
  type OutletStat = {
    name: string;
    avgCrit: number;
    avgHost: number;
    count: number;
  };
  type OutletColors = Record<string, { color: string; text_color: string }>;

  const raw = document.getElementById("chart-data")!.textContent!;
  const { chartPoints, outletStats, outletColors, videoId } = JSON.parse(
    raw,
  ) as {
    chartPoints: ChartPoint[];
    outletStats: OutletStat[];
    outletColors: OutletColors;
    videoId: string | null;
  };

  const cs = getComputedStyle(document.documentElement);
  const clrFg = cs.getPropertyValue("--color-fg").trim() || "#1a1816";
  const clrFg3 = cs.getPropertyValue("--color-fg3").trim() || "#7a756e";
  const clrBorder = cs.getPropertyValue("--color-border").trim() || "#e8e4db";

  function fmtTime(s: number): string {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${m}:${String(sec).padStart(2, "0")}`;
  }

  // ── Filter state ─────────────────────────────────────────────────────────────
  const state = { outlet: "", tag: "", search: "" };
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".qa-card"));
  const qCountEl = document.getElementById("qCount")!;
  const emptyEl = document.getElementById("emptyState")!;
  const total = cards.length;

  // ── Read state ───────────────────────────────────────────────────────────────
  const DATE_KEY = `read-${location.pathname.split("/").filter(Boolean).pop() ?? "unknown"}`;
  const readSet = new Set<string>(
    JSON.parse(localStorage.getItem(DATE_KEY) ?? "[]"),
  );
  let hideRead = false;

  const progressFill = document.getElementById(
    "readProgressFill",
  ) as HTMLElement;
  const progressLabel = document.getElementById(
    "readProgressLabel",
  ) as HTMLElement;
  function updateProgress() {
    const pct = total === 0 ? 0 : Math.round((readSet.size / total) * 100);
    progressFill.style.width = `${pct}%`;
    progressLabel.textContent = `${pct}%`;
    progressLabel.style.opacity = pct >= 5 ? "1" : "0";
  }

  function applyRead() {
    for (const card of cards) {
      const id = card.id.replace("card-", "");
      const isRead = readSet.has(id);
      const body = card.querySelector<HTMLElement>(".qa-body");
      for (const btn of card.querySelectorAll<HTMLElement>(".read-check")) {
        btn.classList.toggle("is-read", isRead);
        btn.textContent = isRead ? "✓ Elolvastam" : "Elolvastam";
      }
      if (body) body.style.display = isRead ? "none" : "";
      card.style.opacity = isRead ? "0.55" : "";
    }
  }

  function applyFilters() {
    let visible = 0;
    for (const card of cards) {
      const outlet = card.dataset.outlet ?? "";
      const tags = card.dataset.tags?.split(",") ?? [];
      const text = card.dataset.text ?? "";
      const id = card.id.replace("card-", "");
      const isRead = readSet.has(id);
      const show =
        (!state.outlet || outlet === state.outlet) &&
        (!state.tag || tags.includes(state.tag)) &&
        (!state.search || text.includes(state.search)) &&
        (!hideRead || !isRead);
      card.style.display = show ? "" : "none";
      if (show) visible++;
    }
    qCountEl.textContent = `${visible} / ${total}`;
    emptyEl.style.display = visible === 0 ? "" : "none";
  }

  function setOutletFilter(outlet: string) {
    state.outlet = outlet;
    (document.getElementById("fOutlet") as HTMLSelectElement).value = outlet;
    applyFilters();
    document
      .getElementById("qaList")!
      .scrollIntoView({ behavior: "smooth", block: "start" });
  }

  document.getElementById("fOutlet")!.addEventListener("change", (e) => {
    state.outlet = (e.target as HTMLSelectElement).value;
    applyFilters();
  });
  document.getElementById("fTag")!.addEventListener("change", (e) => {
    state.tag = (e.target as HTMLSelectElement).value;
    applyFilters();
  });
  document.getElementById("fSearch")!.addEventListener("input", (e) => {
    state.search = (e.target as HTMLInputElement).value.toLowerCase();
    applyFilters();
  });
  document.getElementById("resetBtn")!.addEventListener("click", () => {
    state.outlet = "";
    state.tag = "";
    state.search = "";
    (document.getElementById("fOutlet") as HTMLSelectElement).value = "";
    (document.getElementById("fTag") as HTMLSelectElement).value = "";
    (document.getElementById("fSearch") as HTMLInputElement).value = "";
    applyFilters();
  });

  // Tag clicks (from opening cards and Q&A cards)
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      ".open-tag, .qa-tag",
    );
    if (!btn) return;
    e.stopPropagation();
    const tag = btn.dataset.tag!;
    state.tag = tag;
    (document.getElementById("fTag") as HTMLSelectElement).value = tag;
    applyFilters();
    document
      .getElementById("qaList")!
      .scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // ── Outlet bar charts ─────────────────────────────────────────────────────────
  const outletLabels = outletStats.map((o) => o.name);

  function makeOutletChart(canvasId: string, data: number[], color: string) {
    const canvas = document.getElementById(canvasId) as HTMLCanvasElement;
    new Chart(canvas, {
      type: "bar",
      data: {
        labels: outletLabels,
        datasets: [
          {
            data,
            backgroundColor: color + "cc",
            borderColor: color,
            borderWidth: 1,
            borderRadius: 3,
          },
        ],
      },
      options: {
        indexAxis: "y",
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (item) => `  ${item.raw}%`,
              afterLabel: (item) =>
                `  ${outletStats[item.dataIndex].count} kérdés`,
            },
          },
        },
        scales: {
          x: {
            min: 0,
            max: 100,
            ticks: {
              callback: (v) => `${v}%`,
              font: { family: "'JetBrains Mono', monospace", size: 11 },
              color: clrFg3,
            },
            grid: { color: clrBorder },
          },
          y: {
            ticks: {
              font: { family: "'Source Sans 3', sans-serif", size: 13 },
              color: clrFg,
            },
            grid: { display: false },
          },
        },
        onClick: (_, elements) => {
          if (!elements.length) return;
          const outlet = outletLabels[(elements[0] as { index: number }).index];
          setOutletFilter(state.outlet === outlet ? "" : outlet);
        },
      },
    });
  }

  makeOutletChart(
    "outletCritChart",
    outletStats.map((o) => o.avgCrit),
    "#2a5fa5",
  );
  makeOutletChart(
    "outletHostChart",
    outletStats.map((o) => o.avgHost),
    "#c23a22",
  );

  // ── Timeline charts ───────────────────────────────────────────────────────────
  const maxT =
    chartPoints.length > 0 ? Math.max(...chartPoints.map((p) => p.t)) : 0;

  const pointColors = chartPoints.map(
    (p) => outletColors[p.outlet]?.color ?? "#7a756e",
  );

  function makeTimelineChart(
    canvasId: string,
    yKey: "crit" | "host",
    lineColor: string,
  ) {
    return new Chart(document.getElementById(canvasId) as HTMLCanvasElement, {
      type: "line",
      data: {
        datasets: [
          {
            data: chartPoints.map((p) => ({ x: p.t, y: p[yKey] })),
            borderColor: lineColor,
            borderWidth: 1.5,
            tension: 0.4,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: pointColors,
            pointBorderColor: pointColors,
            pointBorderWidth: 0,
            segment: {
              borderColor: (ctx: { p0DataIndex: number }) =>
                outletColors[chartPoints[ctx.p0DataIndex]?.outlet]?.color ??
                lineColor,
            },
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              title: (items) => {
                const p = chartPoints[items[0].dataIndex];
                return `${p.reporter} · ${p.outlet}`;
              },
              label: (item) =>
                `  ${fmtTime((item.raw as { x: number }).x)}  ·  ${(item.raw as { y: number }).y}%`,
            },
          },
        },
        scales: {
          x: {
            type: "linear",
            min: 0,
            max: maxT,
            ticks: {
              callback: (v) => fmtTime(v as number),
              font: { family: "'JetBrains Mono', monospace", size: 10 },
              color: clrFg3,
              maxTicksLimit: 6,
            },
            grid: { color: clrBorder },
          },
          y: {
            min: 0,
            max: 100,
            ticks: {
              callback: (v) => `${v}%`,
              font: { family: "'JetBrains Mono', monospace", size: 10 },
              color: clrFg3,
              stepSize: 25,
            },
            grid: { color: clrBorder },
          },
        },
        onClick: (_, elements) => {
          if (!elements.length) return;
          const p = chartPoints[(elements[0] as { index: number }).index];
          document
            .getElementById(`card-${p.id}`)
            ?.scrollIntoView({ behavior: "smooth", block: "center" });
        },
      },
    });
  }

  makeTimelineChart("timelineCritChart", "crit", "#2a5fa5");
  makeTimelineChart("timelineHostChart", "host", "#c23a22");

  // ── Read checkbox logic ───────────────────────────────────────────────────────
  applyRead();
  applyFilters();
  updateProgress();

  let lastClickY = 0;
  document.addEventListener("mousedown", (e) => {
    lastClickY = e.clientY;
  });
  document.addEventListener(
    "touchstart",
    (e) => {
      lastClickY = e.touches[0].clientY;
    },
    { passive: true },
  );

  document.addEventListener("click", (e) => {
    const check = (e.target as HTMLElement).closest<HTMLElement>(".read-check");
    if (!check) return;
    const id = String(check.dataset.id!);
    const markingRead = !readSet.has(id);
    const currentCard = check.closest<HTMLElement>(".qa-card")!;
    if (markingRead) readSet.add(id);
    else readSet.delete(id);
    localStorage.setItem(DATE_KEY, JSON.stringify([...readSet]));
    applyRead();
    applyFilters();
    updateProgress();
    if (!markingRead) return;
    // Scroll so the next card's read button center lands exactly under the cursor
    const currentIdx = cards.indexOf(currentCard);
    const nextCard = cards
      .slice(currentIdx + 1)
      .find((c) => c.style.display !== "none");
    if (!nextCard) return;
    const allChecks = nextCard.querySelectorAll<HTMLElement>(".read-check");
    const nextCheck = Array.from(allChecks).find(
      (el) => el.offsetParent !== null,
    );
    if (!nextCheck) return;
    const r = nextCheck.getBoundingClientRect();
    window.scrollBy({
      top: r.top + r.height / 2 - lastClickY,
      behavior: "instant",
    });
  });

  const hideReadBtn = document.getElementById("hideReadBtn")!;
  function updateHideReadBtn() {
    (hideReadBtn.querySelector(".btn-label") as HTMLElement).textContent =
      hideRead ? "Elolvasottak elrejtve" : "Elolvasottak láthatók";
    hideReadBtn.classList.toggle("active", hideRead);
  }
  updateHideReadBtn();
  hideReadBtn.addEventListener("click", () => {
    hideRead = !hideRead;
    updateHideReadBtn();
    applyFilters();
  });

  document.getElementById("unreadAllBtn")?.addEventListener("click", () => {
    readSet.clear();
    localStorage.setItem(DATE_KEY, "[]");
    applyRead();
    applyFilters();
    updateProgress();
  });

  // ── YouTube floating player ───────────────────────────────────────────────────
  if (videoId) {
    let player: any = null;

    const tag = document.createElement("script");
    tag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(tag);

    (window as any).onYouTubeIframeAPIReady = () => {
      player = new (window as any).YT.Player("ytTarget", {
        videoId,
        height: "100%",
        width: "100%",
        playerVars: { rel: 0, modestbranding: 1 },
      });
    };

    // Timestamp seek
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
        ".ts-btn",
      );
      if (!btn) return;
      const secs = parseInt(btn.dataset.seek ?? "0", 10);
      if (!player?.seekTo) return;
      player.seekTo(secs, true);
      player.playVideo();
      // Restore player if minimized
      const embed = document.getElementById("ytEmbed")!;
      if (embed.style.display === "none") embed.style.display = "";
      document.getElementById("ytPlayer")!.style.display = "";
    });

    // Minimize toggle
    document.getElementById("ytMinimize")?.addEventListener("click", () => {
      const embed = document.getElementById("ytEmbed")!;
      embed.style.display = embed.style.display === "none" ? "" : "none";
    });

    // Close
    document.getElementById("ytClose")?.addEventListener("click", () => {
      document.getElementById("ytPlayer")!.style.display = "none";
      player?.pauseVideo?.();
    });
  }
</script>
</Layout>
