---
import Layout from "../../layouts/Layout.astro";
import {
  getAllConferences,
  getConference,
  outlets as outletColorData,
} from "../../lib/data";

export async function getStaticPaths() {
  return getAllConferences().map((c) => ({ params: { date: c.meta.date } }));
}

const { date } = Astro.params;
const conf = getConference(date!);
if (!conf) return Astro.redirect("/");

// Outlet stats for chart
const outletMap: Record<
  string,
  { crits: number[]; hosts: number[]; count: number }
> = {};
for (const q of conf.questions) {
  if (!outletMap[q.outlet])
    outletMap[q.outlet] = { crits: [], hosts: [], count: 0 };
  outletMap[q.outlet].crits.push(q.criticism_percent);
  outletMap[q.outlet].hosts.push(q.hostility_percent);
  outletMap[q.outlet].count++;
}
const outletStats = Object.entries(outletMap)
  .map(([name, d]) => ({
    name,
    avgCrit: Math.round(d.crits.reduce((a, b) => a + b, 0) / d.crits.length),
    avgHost: Math.round(d.hosts.reduce((a, b) => a + b, 0) / d.hosts.length),
    count: d.count,
  }))
  .sort((a, b) => b.avgCrit - a.avgCrit);

// Overall stats
const qCount = conf.questions.length;
const reporterCount = new Set(conf.questions.map((q) => q.reporter)).size;
const outletCount = outletStats.length;
const avgCrit = Math.round(
  conf.questions.reduce((s, q) => s + q.criticism_percent, 0) / qCount,
);
const avgHost = Math.round(
  conf.questions.reduce((s, q) => s + q.hostility_percent, 0) / qCount,
);
const maxCrit = Math.max(...conf.questions.map((q) => q.criticism_percent));

const allOutlets = outletStats.map((o) => o.name);

const allTags = [...new Set(conf.questions.flatMap((q) => q.tags))].sort();

// Timeline chart data
const chartPoints = conf.questions.map((q) => ({
  t: timeToSeconds(q.start_time),
  crit: q.criticism_percent,
  host: q.hostility_percent,
  id: q.id,
  reporter: q.reporter,
  outlet: q.outlet,
}));
const maxTime =
  chartPoints.length > 0 ? Math.max(...chartPoints.map((d) => d.t)) : 0;

const CW = 960,
  CH = 160,
  PL = 44,
  PR = 16,
  PT = 12,
  PB = 28;
const cw = CW - PL - PR;
const ch = CH - PT - PB;
function tx(seconds: number): number {
  return PL + (maxTime > 0 ? (seconds / maxTime) * cw : 0);
}
function ty(pct: number): number {
  return PT + ch - (pct / 100) * ch;
}
function fmtTime(s: number): string {
  const m = Math.floor(s / 60);
  const sec = s % 60;
  return `${m}:${String(sec).padStart(2, "0")}`;
}
const tickInterval = Math.max(60, Math.ceil(maxTime / 7 / 60) * 60);
const xTicks: number[] = [];
for (let t = 0; t <= maxTime; t += tickInterval) xTicks.push(t);
if (xTicks[xTicks.length - 1] < maxTime - 10) xTicks.push(maxTime);

// Outlet bar segments: each question spans to the next question's start
const outletBarSegments = chartPoints.map((p, i) => {
  const nextT = i + 1 < chartPoints.length ? chartPoints[i + 1].t : maxTime;
  return {
    x: tx(p.t),
    width: Math.max(tx(nextT) - tx(p.t), 2),
    outlet: p.outlet,
    id: p.id,
    reporter: p.reporter,
    t: p.t,
  };
});

// Map outlet name to color/text_color
const outletColors: Record<string, { color: string; text_color: string }> =
  Object.fromEntries(
    outletColorData.map((o) => [
      o.name,
      { color: o.color, text_color: o.text_color },
    ]),
  );

function timeToSeconds(t: string): number {
  const parts = t.split(":").map(Number);
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  if (parts.length === 2) return parts[0] * 60 + parts[1];
  return 0;
}
---

<Layout title={conf.meta.title}>
  <!-- Masthead -->
  <header class="bg-fg text-bg">
    <div class="max-w-300 mx-auto px-6 pt-8 pb-7">
      <a
        href="/"
        class="inline-block font-mono text-[11px] tracking-[1px] uppercase text-[#777] no-underline mb-3 transition-colors duration-150 hover:text-[#e8624e]"
      >← Összes sajtótájékoztató</a>
      <div class="font-mono text-xs tracking-[2px] uppercase text-[#999] mb-2">
        Kormányinfó · {conf.meta.location}
      </div>
      <h1 class="font-display text-[clamp(28px,5vw,48px)] font-black leading-tight mb-2 tracking-[-0.5px]">
        Sajtótájékoztató
      </h1>
      <p class="text-[18px] font-light text-[#bbb] max-w-175">
        A kormány sajtótájékoztatójának teljes Q&amp;A feldolgozása — kérdések,
        válaszok, kritikusság és ellenségesség elemzéssel
      </p>
      <div class="flex gap-3 mt-4 flex-wrap">
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          <span>{conf.meta.date.replace(/-/g, ". ")}</span>
        </div>
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          Miniszter: <span class="text-[#e8624e] font-semibold"
            >{conf.speakers.find((s) => s.role === "miniszter")?.name}</span
          >
        </div>
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          Időtartam: <span class="text-[#e8624e] font-semibold">{conf.meta.duration}</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Stats bar -->
  <div class="bg-bg2 border-b border-border">
    <div class="max-w-300 mx-auto px-6 py-5 grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] max-[700px]:grid-cols-3 gap-4">
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{qCount}</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Kérdés</div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{reporterCount}</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Újságíró</div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{outletCount}</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Médium</div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{avgCrit}%</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Átl. kritikusság</div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{avgHost}%</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Átl. ellenségesség</div>
      </div>
      <div class="text-center">
        <div class="font-display text-[32px] font-bold text-accent">{maxCrit}%</div>
        <div class="text-xs uppercase tracking-[1px] text-fg3 font-semibold">Max kritikusság</div>
      </div>
    </div>
  </div>

  <!-- Opening statements -->
  <div class="max-w-300 mx-auto px-6 pt-8 pb-3">
    <h2 class="font-display text-2xl font-bold flex items-center gap-2.5">
      Nyitó nyilatkozatok <span class="font-mono text-sm font-normal text-fg3 bg-bg2 px-2.5 py-0.5 rounded-full"
        >{conf.opening_statements.length}</span
      >
    </h2>
  </div>
  <div class="max-w-300 mx-auto px-6 pb-3 grid grid-cols-[repeat(auto-fit,minmax(400px,1fr))] max-[700px]:grid-cols-1 gap-4">
    {
      conf.opening_statements.map((stmt) => (
        <div class="bg-white border border-border rounded-md p-5 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-1 h-full bg-accent" />
          <div class="font-mono text-xs text-fg3">
            {stmt.start_time} – {stmt.end_time}
          </div>
          {(() => {
            const sp = conf.speakers.find((s) => s.id === stmt.speaker_id);
            return (
              <div class="font-bold text-[15px] my-1">
                {sp?.name} <span class="font-normal text-fg3">· {sp?.role}</span>
              </div>
            );
          })()}
          <div class="text-sm text-fg2 leading-relaxed">{stmt.summary}</div>
          <div class="flex flex-wrap gap-1 mt-2.5">
            {stmt.tags.map((t) => (
              <button class="open-tag tag" data-tag={t}>
                {t}
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- Outlet chart -->
  <div class="max-w-300 mx-auto px-6 py-6">
    <h2 class="font-display text-xl font-bold mb-3">Médiumok összehasonlítása</h2>
    <div class="flex gap-4 mb-3 text-xs text-fg3">
      <span class="flex items-center">
        <span class="inline-block w-2.5 h-2.5 rounded-xs bg-blue mr-1.5"></span>
        Kérdés kritikussága
      </span>
      <span class="flex items-center">
        <span class="inline-block w-2.5 h-2.5 rounded-xs bg-accent mr-1.5"></span>
        Válasz ellenségessége
      </span>
    </div>
    <div class="flex flex-col gap-1.5">
      {
        outletStats.map((s) => {
          const cw = Math.max(s.avgCrit, 2);
          const hw = Math.max(s.avgHost, 2);
          const c = outletColors[s.name];
          return (
            <div
              class="outlet-row grid grid-cols-[130px_1fr_1fr_50px] max-[700px]:grid-cols-[90px_1fr_1fr_36px] gap-3 items-center text-[13px] max-[700px]:text-xs py-1.5 border-b border-bg2 last:border-0 cursor-pointer rounded transition-colors duration-150 hover:bg-bg2"
              data-outlet={s.name}
              role="button"
              tabindex="0"
            >
              <div
                class="font-semibold text-[13px] whitespace-nowrap overflow-hidden text-ellipsis"
                title={s.name}
                style={
                  c
                    ? `background:${c.color};color:${c.text_color};padding:2px 8px;border-radius:4px;max-width:110px;`
                    : undefined
                }
              >
                {s.name}
              </div>
              <div class="flex items-center gap-2">
                <div class="h-5 bg-bg2 rounded-[3px] relative flex-1">
                  <div class="h-full rounded-[3px] transition-[width] duration-600 ease-in-out bg-blue" style={`width:${cw}%`} />
                </div>
                <span class="font-mono text-[11px] font-semibold text-fg2 min-w-8.75 text-left">{s.avgCrit}%</span>
              </div>
              <div class="flex items-center gap-2">
                <div class="h-5 bg-bg2 rounded-[3px] relative flex-1">
                  <div class="h-full rounded-[3px] transition-[width] duration-600 ease-in-out bg-accent" style={`width:${hw}%`} />
                </div>
                <span class="font-mono text-[11px] font-semibold text-fg2 min-w-8.75 text-left">{s.avgHost}%</span>
              </div>
              <div class="font-mono text-xs text-fg3 text-right">{s.count} db</div>
            </div>
          );
        })
      }
    </div>
  </div>

  <!-- Timeline charts -->
  <div class="max-w-300 mx-auto px-6 py-6">
    <h2 class="font-display text-xl font-bold mb-3">Idővonal</h2>
    <div class="flex flex-col gap-2">
      <div>
        <div class="text-[11px] font-bold tracking-[0.8px] uppercase mb-1.5 text-blue">Kérdés kritikussága</div>
        <svg
          class="w-full h-40 block overflow-visible"
          viewBox={`0 0 ${CW} ${CH}`}
          preserveAspectRatio="none"
          aria-label="Kérdés kritikussága idővonalon"
        >
          {
            [0, 25, 50, 75, 100].map((pct) => (
              <>
                <line
                  x1={PL}
                  x2={CW - PR}
                  y1={ty(pct)}
                  y2={ty(pct)}
                  stroke="#e8e4db"
                  stroke-width="1"
                />
                <text
                  x={PL - 5}
                  y={ty(pct) + 4}
                  text-anchor="end"
                  font-size="10"
                  fill="#7a756e"
                >
                  {pct}
                </text>
              </>
            ))
          }
          {
            xTicks.map((t) => (
              <>
                <line
                  x1={tx(t)}
                  x2={tx(t)}
                  y1={PT + ch}
                  y2={PT + ch + 4}
                  stroke="#7a756e"
                  stroke-width="1"
                />
                <text
                  x={tx(t)}
                  y={PT + ch + 16}
                  text-anchor="middle"
                  font-size="10"
                  fill="#7a756e"
                >
                  {fmtTime(t)}
                </text>
              </>
            ))
          }
          <polyline
            points={chartPoints
              .map((p) => `${tx(p.t)},${ty(p.crit)}`)
              .join(" ")}
            fill="none"
            stroke="var(--color-blue)"
            stroke-width="1.5"
            stroke-opacity="0.35"></polyline>
          {
            chartPoints.map((p) => (
              <circle
                cx={tx(p.t)}
                cy={ty(p.crit)}
                r="5"
                fill="var(--color-blue)"
                stroke="white"
                stroke-width="1.5"
                class="timeline-dot cursor-pointer"
                data-id={p.id}
                data-reporter={p.reporter}
                data-outlet={p.outlet}
                data-val={p.crit}
                data-t={fmtTime(p.t)}
              />
            ))
          }
        </svg>
      </div>

      <div>
        <div class="text-[11px] font-bold tracking-[0.8px] uppercase mb-1.5 text-accent">Válasz ellenségessége</div>
        <svg
          class="w-full h-40 block overflow-visible"
          viewBox={`0 0 ${CW} ${CH}`}
          preserveAspectRatio="none"
          aria-label="Válasz ellenségessége idővonalon"
        >
          {
            [0, 25, 50, 75, 100].map((pct) => (
              <>
                <line
                  x1={PL}
                  x2={CW - PR}
                  y1={ty(pct)}
                  y2={ty(pct)}
                  stroke="#e8e4db"
                  stroke-width="1"
                />
                <text
                  x={PL - 5}
                  y={ty(pct) + 4}
                  text-anchor="end"
                  font-size="10"
                  fill="#7a756e"
                >
                  {pct}
                </text>
              </>
            ))
          }
          {
            xTicks.map((t) => (
              <>
                <line
                  x1={tx(t)}
                  x2={tx(t)}
                  y1={PT + ch}
                  y2={PT + ch + 4}
                  stroke="#7a756e"
                  stroke-width="1"
                />
                <text
                  x={tx(t)}
                  y={PT + ch + 16}
                  text-anchor="middle"
                  font-size="10"
                  fill="#7a756e"
                >
                  {fmtTime(t)}
                </text>
              </>
            ))
          }
          <polyline
            points={chartPoints
              .map((p) => `${tx(p.t)},${ty(p.host)}`)
              .join(" ")}
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.5"
            stroke-opacity="0.35"></polyline>
          {
            chartPoints.map((p) => (
              <circle
                cx={tx(p.t)}
                cy={ty(p.host)}
                r="5"
                fill="var(--color-accent)"
                stroke="white"
                stroke-width="1.5"
                class="timeline-dot cursor-pointer"
                data-id={p.id}
                data-reporter={p.reporter}
                data-outlet={p.outlet}
                data-val={p.host}
                data-t={fmtTime(p.t)}
              />
            ))
          }
        </svg>
      </div>
    </div>
    <!-- Outlet bar -->
    <div>
      <div class="text-[11px] font-bold tracking-[0.8px] uppercase mb-1.5 text-fg3">Médium</div>
      <svg
        class="w-full h-10 block overflow-visible"
        viewBox={`0 0 ${CW} 32`}
        preserveAspectRatio="none"
        aria-label="Médiumok idővonalon"
      >
        <text x={PL - 5} y={20} text-anchor="end" font-size="10" fill="#7a756e">
        </text>
        {
          outletBarSegments.map((seg) => {
            const c = outletColors[seg.outlet];
            return (
              <rect
                x={seg.x}
                y={8}
                width={seg.width}
                height={16}
                fill={c ? c.color : "#ccc6bb"}
                class="timeline-dot outlet-bar-seg cursor-pointer"
                data-id={seg.id}
                data-outlet={seg.outlet}
                data-reporter={seg.reporter}
                data-t={fmtTime(seg.t)}
                data-val={seg.outlet}
              />
            );
          })
        }
        {
          xTicks.map((t) => (
            <>
              <line
                x1={tx(t)}
                x2={tx(t)}
                y1={24}
                y2={28}
                stroke="#7a756e"
                stroke-width="1"
              />
              <text
                x={tx(t)}
                y={32}
                text-anchor="middle"
                font-size="10"
                fill="#7a756e"
              >
                {fmtTime(t)}
              </text>
            </>
          ))
        }
      </svg>
    </div>
  </div>
  <div id="timeline-tooltip" class="fixed z-1000 bg-fg text-bg px-2.75 py-1.75 rounded text-xs pointer-events-none whitespace-nowrap shadow-[0_2px_8px_rgba(0,0,0,0.25)] leading-normal" style="display:none">
  </div>
</Layout>

<!-- Filter controls -->
<div class="max-w-300 mx-auto px-6 pt-6">
  <div class="flex gap-3 flex-wrap items-end">
    <div class="flex flex-col gap-1">
      <label class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold">Médium</label>
      <select id="fOutlet" class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent">
        <option value="">Mind ({allOutlets.length})</option>
        {allOutlets.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold">Téma</label>
      <select id="fTag" class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent">
        <option value="">Mind ({allTags.length})</option>
        {allTags.map((t) => <option value={t}>{t}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold">Keresés</label>
      <input
        type="text"
        id="fSearch"
        placeholder="kérdés vagy válasz..."
        class="font-body text-sm px-3 py-2 border border-border rounded-md bg-white text-fg outline-none transition-[border-color] duration-200 focus:border-accent w-45"
      />
    </div>
    <button class="font-body text-[13px] px-4 py-2 border border-border rounded-md bg-white text-fg2 cursor-pointer transition-all duration-200 hover:bg-fg hover:text-white hover:border-fg" id="resetBtn">Szűrők törlése</button>
  </div>
</div>

<!-- Q&A -->
<div class="max-w-300 mx-auto px-6 pt-8 pb-3">
  <h2 class="font-display text-2xl font-bold flex items-center gap-2.5">
    Kérdések és válaszok <span class="font-mono text-sm font-normal text-fg3 bg-bg2 px-2.5 py-0.5 rounded-full" id="qCount"
      >{qCount} / {qCount}</span
    >
  </h2>
</div>
<div class="max-w-300 mx-auto px-6 pb-10" id="qaList">
  {
    conf.questions.map((q) => {
      const ytUrl = conf.meta.youtube_url
        ? `${conf.meta.youtube_url}&t=${timeToSeconds(q.start_time)}`
        : null;
      const critC = 2 * Math.PI * 34;
      const hostC = 2 * Math.PI * 34;
      const critOffset = critC - (q.criticism_percent / 100) * critC;
      const hostOffset = hostC - (q.hostility_percent / 100) * hostC;

      return (
        <div
          class="qa-card bg-white border border-[rgba(226,191,184,0.3)] rounded-lg mb-6 overflow-hidden shadow-[0_1px_3px_rgba(0,0,0,0.05)]"
          id={`card-${q.id}`}
          data-outlet={q.outlet}
          data-tags={q.tags.join(",")}
          data-crit={q.criticism_percent}
          data-host={q.hostility_percent}
          data-text={`${q.question} ${q.answer}`.toLowerCase()}
        >
          <div class="flex items-center justify-between p-5 border-b border-[rgba(226,191,184,0.1)] max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-3 max-[700px]:p-4">
            <div class="flex items-center gap-4 max-[700px]:flex-col max-[700px]:items-start max-[700px]:gap-2">
              <span class="font-mono text-base font-medium text-accent">
                {ytUrl ? (
                  <a href={ytUrl} target="_blank" rel="noopener" class="text-accent no-underline transition-opacity duration-150 hover:opacity-70">
                    {q.start_time}
                  </a>
                ) : (
                  q.start_time
                )}
              </span>
              <div class="w-px h-4 bg-[rgba(226,191,184,0.4)] max-[700px]:hidden" />
              <div class="flex items-center gap-2">
                <span class="font-mono text-[10px] uppercase font-bold tracking-[1.5px] text-[rgba(27,28,26,0.6)]">Újságíró:</span>
                <span class="font-display italic text-[15px] text-fg">{q.reporter}</span>
              </div>
            </div>
            <div>
              {(() => {
                const c = outletColors[q.outlet];
                return c ? (
                  <span
                    class="px-3 py-1.5 rounded-xs text-[10px] font-mono font-black tracking-[2px] uppercase"
                    style={`background:${c.color};color:${c.text_color}`}
                  >
                    {q.outlet}
                  </span>
                ) : (
                  <span class="bg-fg3 text-white px-3 py-1.5 rounded-xs text-[10px] font-mono font-black tracking-[2px] uppercase">{q.outlet}</span>
                );
              })()}
            </div>
          </div>

          <div class="grid grid-cols-[2fr_1fr] max-[700px]:grid-cols-1 gap-8 max-[700px]:gap-5 p-5 max-[700px]:p-4">
            <div class="min-w-0">
              <div class="mb-5">
                <h3 class="font-body text-[22px] max-[700px]:text-[18px] font-bold leading-tight text-fg tracking-[-0.3px]">{q.question}</h3>
              </div>
              <div class="relative p-5 rounded-r-lg border-l-[5px] border-accent mb-3 [background:color-mix(in_srgb,var(--color-accent)_10%,transparent)]">
                <div class="absolute -top-3 -left-[10px] bg-accent text-white font-mono text-[9px] px-[7px] py-[3px] font-bold">Válasz:</div>
                <p class="text-[15px] max-[700px]:text-sm leading-[1.7] text-[rgba(27,28,26,0.9)]">{q.answer}</p>
              </div>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {q.tags.map((t) => (
                  <button
                    class="qa-tag text-[10px] font-semibold px-3 py-1 rounded-[3px] bg-bg2 text-fg2 border border-transparent transition-all duration-150 cursor-pointer hover:bg-blue-light hover:text-blue hover:border-blue hover:-translate-y-px"
                    data-tag={t}
                  >
                    {t}
                  </button>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-center border-l border-[rgba(226,191,184,0.1)] pl-5 max-[700px]:border-l-0 max-[700px]:border-t max-[700px]:border-[rgba(226,191,184,0.1)] max-[700px]:pl-0 max-[700px]:pt-5">
              <div class="flex flex-col max-[700px]:flex-row items-center gap-8 max-[700px]:gap-6">
                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 relative flex items-center justify-center">
                    <svg
                      width="80"
                      height="80"
                      viewBox="0 0 80 80"
                      style="transform:rotate(-90deg)"
                    >
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="#e8e4db"
                        stroke-width="5"
                      />
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-blue)"
                        stroke-width="6"
                        stroke-dasharray={critC}
                        stroke-dashoffset={critOffset}
                        stroke-linecap="round"
                      />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center font-mono text-[22px] font-bold">
                      {q.criticism_percent}
                      <span class="text-xs">%</span>
                    </div>
                  </div>
                  <div class="font-mono text-[9px] uppercase tracking-[1px] font-black text-[rgba(27,28,26,0.7)]">KRIT. INDEX</div>
                </div>

                <div class="flex flex-col items-center gap-2">
                  <div class="w-20 h-20 relative flex items-center justify-center">
                    <svg
                      width="80"
                      height="80"
                      viewBox="0 0 80 80"
                      style="transform:rotate(-90deg)"
                    >
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="#e8e4db"
                        stroke-width="5"
                      />
                      <circle
                        cx="40"
                        cy="40"
                        r="34"
                        fill="none"
                        stroke="var(--color-accent)"
                        stroke-width="6"
                        stroke-dasharray={hostC}
                        stroke-dashoffset={hostOffset}
                        stroke-linecap="round"
                      />
                    </svg>
                    <div class="absolute inset-0 flex items-center justify-center font-mono text-[22px] font-bold">
                      {q.hostility_percent}
                      <span class="text-xs">%</span>
                    </div>
                  </div>
                  <div class="font-mono text-[9px] uppercase tracking-[1px] font-black text-[rgba(27,28,26,0.7)]">ELL. FAKTOR</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<div class="max-w-300 mx-auto text-center px-6 py-15 text-fg3" id="emptyState" style="display:none">
  <div class="font-display text-2xl text-fg2 mb-2">Nincs találat</div>
  <div>Próbálj más szűrőket</div>
</div>

<script>
  const state = { outlet: "", tag: "", search: "" };

  const cards = Array.from(document.querySelectorAll<HTMLElement>(".qa-card"));
  const outletRows = Array.from(
    document.querySelectorAll<HTMLElement>(".outlet-row[data-outlet]"),
  );
  const qCountEl = document.getElementById("qCount")!;
  const emptyEl = document.getElementById("emptyState")!;
  const total = cards.length;

  function syncOutletRows() {
    for (const row of outletRows) {
      row.classList.toggle(
        "active",
        row.dataset.outlet === state.outlet && state.outlet !== "",
      );
    }
  }

  function applyFilters() {
    let visible = 0;
    for (const card of cards) {
      const outlet = card.dataset.outlet ?? "";
      const tags = card.dataset.tags?.split(",") ?? [];
      const text = card.dataset.text ?? "";

      const show =
        (!state.outlet || outlet === state.outlet) &&
        (!state.tag || tags.includes(state.tag)) &&
        (!state.search || text.includes(state.search));

      card.style.display = show ? "" : "none";
      if (show) visible++;
    }
    qCountEl.textContent = `${visible} / ${total}`;
    emptyEl.style.display = visible === 0 ? "" : "none";
    syncOutletRows();
  }

  // Filter controls
  document.getElementById("fOutlet")!.addEventListener("change", (e) => {
    state.outlet = (e.target as HTMLSelectElement).value;
    applyFilters();
  });
  document.getElementById("fTag")!.addEventListener("change", (e) => {
    state.tag = (e.target as HTMLSelectElement).value;
    applyFilters();
  });
  document.getElementById("fSearch")!.addEventListener("input", (e) => {
    state.search = (e.target as HTMLInputElement).value.toLowerCase();
    applyFilters();
  });
  document.getElementById("resetBtn")!.addEventListener("click", () => {
    state.outlet = "";
    state.tag = "";
    state.search = "";
    (document.getElementById("fOutlet") as HTMLSelectElement).value = "";
    (document.getElementById("fTag") as HTMLSelectElement).value = "";
    (document.getElementById("fSearch") as HTMLInputElement).value = "";
    applyFilters();
  });

  // Outlet chart row clicks → filter
  document.addEventListener("click", (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>(".outlet-row");
    if (!row) return;
    const outlet = row.dataset.outlet!;
    if (state.outlet === outlet) {
      state.outlet = "";
      (document.getElementById("fOutlet") as HTMLSelectElement).value = "";
    } else {
      state.outlet = outlet;
      (document.getElementById("fOutlet") as HTMLSelectElement).value = outlet;
    }
    applyFilters();
    document
      .getElementById("qaList")!
      .scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Tag clicks (from opening cards and Q&A cards)
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      ".open-tag, .qa-tag",
    );
    if (!btn) return;
    e.stopPropagation();
    const tag = btn.dataset.tag!;
    state.tag = tag;
    (document.getElementById("fTag") as HTMLSelectElement).value = tag;
    applyFilters();
    document
      .getElementById("qaList")!
      .scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Timeline dot tooltip + click-to-scroll
  const tlTooltip = document.getElementById("timeline-tooltip")!;

  document.addEventListener("mouseover", (e) => {
    const dot = (e.target as Element).closest<SVGCircleElement>(
      ".timeline-dot",
    );
    if (!dot) return;
    const valStr = dot.classList.contains("outlet-bar-seg")
      ? dot.dataset.outlet!
      : `${dot.dataset.val}%`;
    tlTooltip.innerHTML = `<strong>${dot.dataset.reporter}</strong> · ${dot.dataset.outlet}<br>${dot.dataset.t} &nbsp;·&nbsp; ${valStr}`;
    tlTooltip.style.display = "block";
    if (dot.tagName === "circle") dot.setAttribute("r", "7");
  });

  document.addEventListener("mouseout", (e) => {
    const dot = (e.target as Element).closest<SVGCircleElement>(
      ".timeline-dot",
    );
    if (!dot) return;
    tlTooltip.style.display = "none";
    if (dot.tagName === "circle") dot.setAttribute("r", "5");
  });

  document.addEventListener("mousemove", (e) => {
    if (tlTooltip.style.display === "none") return;
    tlTooltip.style.left = `${e.clientX + 14}px`;
    tlTooltip.style.top = `${e.clientY - 36}px`;
  });

  document.addEventListener("click", (e) => {
    const dot = (e.target as Element).closest<SVGCircleElement>(
      ".timeline-dot",
    );
    if (!dot) return;
    const card = document.getElementById(`card-${dot.dataset.id}`);
    if (card) card.scrollIntoView({ behavior: "smooth", block: "center" });
  });
</script>

<style>
  /* JS-toggled active state for outlet chart rows */
  .outlet-row.active {
    background-color: var(--color-blue-light);
    outline: 2px solid var(--color-blue);
  }
  /* SVG rect hover opacity (can't be done inline on SVG elements) */
  .outlet-bar-seg {
    opacity: 0.85;
  }
  .outlet-bar-seg:hover {
    opacity: 1;
  }
</style>
