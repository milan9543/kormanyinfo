---
import Layout from "../layouts/Layout.astro";
import { getAllConferences } from "../lib/data";

const conferences = getAllConferences();

function avg(arr: number[]) {
  return arr.length ? Math.round(arr.reduce((a, b) => a + b, 0) / arr.length) : 0;
}

function timeAgo(dateStr: string): string {
  const days = Math.round((Date.now() - new Date(dateStr).getTime()) / 86_400_000);
  if (days <= 1) return "ma";
  if (days < 7) return `${days} napja`;
  const weeks = Math.floor(days / 7);
  if (days < 30) return weeks === 1 ? "1 hete" : `${weeks} hete`;
  const months = Math.floor(days / 30);
  return months === 1 ? "1 hónapja" : `${months} hónapja`;
}
---

<Layout title="Sajtótájékoztatók">

  <!-- Masthead -->
  <header class="bg-fg text-bg">
    <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pt-10 pb-9">
      <div class="font-mono text-xs tracking-[2px] uppercase text-[#999] mb-2">Hangnem · Adatbázis</div>
      <h1 class="font-display text-[clamp(28px,5vw,48px)] font-black leading-tight mb-2">Sajtótájékoztatók</h1>
      <p class="text-[17px] font-light text-[#bbb] max-w-150 mb-4">A kormány sajtótájékoztatóinak teljes Q&A feldolgozása — kérdések, kritikusság és ellenségesség elemzéssel</p>
      <div class="flex gap-3 flex-wrap">
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          <span class="text-[#e8624e] font-semibold">{conferences.length}</span> sajtótájékoztató
        </div>
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          <span class="text-[#e8624e] font-semibold">{conferences.reduce((s, c) => s + c.questions.length, 0)}</span> kérdés összesen
        </div>
      </div>
    </div>
  </header>

  <!-- Conference list -->
  <div class="max-w-300 mx-auto px-6 max-[480px]:px-4 pt-8 pb-15 flex flex-col gap-3">
    {conferences.map((conf) => {
      const crits = conf.questions.map(q => q.criticism_percent);
      const hosts = conf.questions.map(q => q.hostility_percent);
      const avgCrit = avg(crits);
      const avgHost = avg(hosts);
      const outlets = [...new Set(conf.questions.map(q => q.outlet))];
      const maxCrit = crits.length ? Math.max(...crits) : 0;
      const speakerObj = conf.speakers.find(s => s.role === "miniszter") ?? conf.speakers[0];
      const speaker = speakerObj?.name;

      return (
        <a
          href={`/conferences/${conf.meta.date}`}
          class="flex flex-col bg-white border border-border rounded-lg overflow-hidden no-underline text-inherit transition-all duration-200 hover:border-accent hover:shadow-[0_4px_20px_rgba(194,58,34,0.09)]"
        >
          {/* Top: identity + counts */}
          <div class="flex items-start gap-6 px-6 pt-5 pb-4 max-[600px]:flex-col max-[600px]:gap-2">

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-mono text-[11px] text-fg3">{conf.meta.date.replace(/-/g, ". ")}</span>
                <span class="text-[10px] font-medium px-1.5 py-0.5 rounded-full bg-bg2 text-fg3 leading-none">{timeAgo(conf.meta.date)}</span>
                {conf.meta.location && <span class="text-[11px] text-fg3">· {conf.meta.location}</span>}
              </div>
              <h2 class="font-display text-[22px] font-bold leading-tight tracking-[-0.3px] text-fg mb-2">{conf.meta.title}</h2>
              {speaker && (
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded-full bg-accent flex items-center justify-center shrink-0">
                    <span class="font-display font-black text-white text-[9px]">
                      {speaker.split(" ").map((w: string) => w[0]).join("").slice(0, 2)}
                    </span>
                  </div>
                  <span class="font-display text-[15px] font-bold text-fg2">{speaker}</span>
                </div>
              )}
            </div>

            <div class="flex items-center gap-5 shrink-0 max-[600px]:gap-6">
              <div>
                <div class="font-display text-[30px] font-bold text-accent leading-none">{conf.questions.length}</div>
                <div class="text-[10px] uppercase tracking-[1.5px] text-fg3 font-semibold mt-1">kérdés</div>
              </div>
              <div class="w-px h-8 bg-border"></div>
              <div>
                <div class="font-display text-[30px] font-bold text-accent leading-none">{outlets.length}</div>
                <div class="text-[10px] uppercase tracking-[1.5px] text-fg3 font-semibold mt-1">médium</div>
              </div>
            </div>

          </div>

          {/* Outlet tags */}
          <div class="px-6 pb-4 flex flex-wrap gap-1">
            {outlets.map(o => <span class="tag cursor-default">{o}</span>)}
          </div>

          {/* Metrics strip */}
          <div class="border-t border-border bg-bg px-6 py-3 flex gap-x-8 gap-y-2 flex-wrap">
            <div class="flex items-center gap-2.5 min-w-45 flex-1">
              <span class="text-[11px] text-fg3 w-32 shrink-0">Átl. kritikusság</span>
              <div class="flex-1 h-1 bg-bg3 rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-blue" style={`width:${avgCrit}%`}></div>
              </div>
              <span class="font-mono text-[11px] text-fg2 w-7 text-right">{avgCrit}%</span>
            </div>
            <div class="flex items-center gap-2.5 min-w-45 flex-1">
              <span class="text-[11px] text-fg3 w-32 shrink-0">Átl. ellenségesség</span>
              <div class="flex-1 h-1 bg-bg3 rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-accent" style={`width:${avgHost}%`}></div>
              </div>
              <span class="font-mono text-[11px] text-fg2 w-7 text-right">{avgHost}%</span>
            </div>
            <div class="flex items-center gap-2.5 min-w-45 flex-1">
              <span class="text-[11px] text-fg3 w-32 shrink-0">Max kritikusság</span>
              <div class="flex-1 h-1 bg-bg3 rounded-full overflow-hidden">
                <div class="h-full rounded-full bg-blue opacity-50" style={`width:${maxCrit}%`}></div>
              </div>
              <span class="font-mono text-[11px] text-fg2 w-7 text-right">{maxCrit}%</span>
            </div>
          </div>

        </a>
      );
    })}
  </div>

</Layout>
