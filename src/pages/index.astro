---
import Layout from "../layouts/Layout.astro";
import { getAllConferences } from "../lib/data";

const conferences = getAllConferences();

function avg(arr: number[]) {
  return arr.length ? Math.round(arr.reduce((a, b) => a + b, 0) / arr.length) : 0;
}
---

<Layout title="Sajtótájékoztatók">

  <!-- Masthead -->
  <header class="bg-fg text-bg">
    <div class="max-w-300 mx-auto px-6 pt-10 pb-9">
      <div class="font-mono text-xs tracking-[2px] uppercase text-[#999] mb-2">Kormányinfó · Adatbázis</div>
      <h1 class="font-display text-[clamp(28px,5vw,48px)] font-black leading-tight mb-2">Sajtótájékoztatók</h1>
      <p class="text-[17px] font-light text-[#bbb] max-w-150 mb-4">A kormány sajtótájékoztatóinak teljes Q&A feldolgozása — kérdések, kritikusság és ellenségesség elemzéssel</p>
      <div class="flex gap-3 flex-wrap">
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          <span class="text-[#e8624e] font-semibold">{conferences.length}</span> sajtótájékoztató
        </div>
        <div class="text-[13px] font-medium px-3 py-1 rounded-full bg-white/8 text-[#ccc]">
          <span class="text-[#e8624e] font-semibold">{conferences.reduce((s, c) => s + c.questions.length, 0)}</span> kérdés összesen
        </div>
      </div>
    </div>
  </header>

  <!-- Conference list -->
  <div class="max-w-300 mx-auto px-6 pt-8 pb-15 flex flex-col gap-2.5">
    {conferences.map((conf) => {
      const crits = conf.questions.map(q => q.criticism_percent);
      const hosts = conf.questions.map(q => q.hostility_percent);
      const avgCrit = avg(crits);
      const avgHost = avg(hosts);
      const outlets = [...new Set(conf.questions.map(q => q.outlet))];
      const maxCrit = crits.length ? Math.max(...crits) : 0;

      return (
        <a
          href={`/conferences/${conf.meta.date}`}
          class="flex gap-6 bg-white border border-border rounded-md px-6 py-5 no-underline text-inherit transition-[border-color,box-shadow] duration-200 hover:border-accent hover:shadow-[0_2px_12px_rgba(194,58,34,0.08)] max-[700px]:flex-col"
        >
          <div class="flex-1 min-w-0">
            <div class="font-mono text-xs text-fg3 mb-1">{conf.meta.date}</div>
            <h2 class="font-display text-xl font-bold mb-1 leading-tight">{conf.meta.title}</h2>
            <div class="text-sm text-fg3 mb-2.5">{conf.speakers.find(s => s.role === "miniszter")?.name} · {conf.meta.location}</div>
            <div class="flex flex-wrap gap-1">
              {outlets.map(o => <span class="tag cursor-default">{o}</span>)}
            </div>
          </div>
          <div class="shrink-0 flex flex-col gap-4 min-w-[280px] max-[700px]:min-w-0">
            <div class="flex gap-6 max-[700px]:justify-start">
              <div class="text-center">
                <div class="font-display text-[28px] font-bold text-accent leading-none">{conf.questions.length}</div>
                <div class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold mt-0.5">kérdés</div>
              </div>
              <div class="text-center">
                <div class="font-display text-[28px] font-bold text-accent leading-none">{outlets.length}</div>
                <div class="text-[11px] uppercase tracking-[1px] text-fg3 font-semibold mt-0.5">médium</div>
              </div>
            </div>
            <div class="flex flex-col gap-1.5">
              <div class="flex items-center gap-2 text-xs">
                <span class="text-fg3 w-35 shrink-0">Átl. kritikusság</span>
                <div class="flex-1 h-1.5 bg-bg2 rounded-[3px] overflow-hidden">
                  <div class="h-full rounded-[3px] transition-[width] duration-400 ease-in-out bg-blue" style={`width:${avgCrit}%`}></div>
                </div>
                <span class="font-mono text-[11px] text-fg2 w-7.5 text-right">{avgCrit}%</span>
              </div>
              <div class="flex items-center gap-2 text-xs">
                <span class="text-fg3 w-35 shrink-0">Átl. ellenségesség</span>
                <div class="flex-1 h-1.5 bg-bg2 rounded-[3px] overflow-hidden">
                  <div class="h-full rounded-[3px] transition-[width] duration-400 ease-in-out bg-accent" style={`width:${avgHost}%`}></div>
                </div>
                <span class="font-mono text-[11px] text-fg2 w-7.5 text-right">{avgHost}%</span>
              </div>
              <div class="flex items-center gap-2 text-xs">
                <span class="text-fg3 w-35 shrink-0">Max kritikusság</span>
                <div class="flex-1 h-1.5 bg-bg2 rounded-[3px] overflow-hidden">
                  <div class="h-full rounded-[3px] transition-[width] duration-400 ease-in-out bg-blue opacity-40" style={`width:${maxCrit}%`}></div>
                </div>
                <span class="font-mono text-[11px] text-fg2 w-7.5 text-right">{maxCrit}%</span>
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

</Layout>
